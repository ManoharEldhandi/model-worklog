{
  "name": "model-worklog",
  "publisher": "manohareldhandi",
  "displayName": "Model Logger",
  "description": "Local-first, redacted AI activity logging and review",
  "version": "0.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ManoharEldhandi/model-worklog.git"
  },
  "homepage": "https://github.com/ManoharEldhandi/model-worklog#readme",
  "bugs": {
    "url": "https://github.com/ManoharEldhandi/model-worklog/issues"
  },
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "AI",
    "agent",
    "Codex",
    "logging",
    "observability",
    "privacy"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "model-worklog.enable",
        "title": "Enable Model Logger",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.disable",
        "title": "Disable Model Logger",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.reconnect",
        "title": "Reconnect Model Logger",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.startCodexSession",
        "title": "Log a Codex Task",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.startCopilotSession",
        "title": "Log a Copilot CLI Task",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.startCopilotInteractiveSession",
        "title": "Start Interactive Copilot CLI",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.stopLiveLog",
        "title": "Stop Live Log",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.refreshSessions",
        "title": "Refresh Logs",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.openSessionLog",
        "title": "View Log",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.exportEvidenceBundle",
        "title": "Download Log JSON",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.deleteSession",
        "title": "Delete Saved Log",
        "category": "Model Logger"
      },
      {
        "command": "model-worklog.trace.selectProject",
        "title": "Select Trace Project",
        "category": "Model Logger",
        "icon": "$(folder)"
      },
      {
        "command": "model-worklog.trace.configureSdk",
        "title": "Configure SDK Logging",
        "category": "Model Logger",
        "icon": "$(settings-gear)",
        "enablement": "modelWorklog.traceAdmin && !modelWorklog.traceBusy"
      },
      {
        "command": "model-worklog.trace.refresh",
        "title": "Refresh Traces",
        "category": "Model Logger",
        "icon": "$(refresh)",
        "enablement": "modelWorklog.traceEnabled && !modelWorklog.traceBusy"
      },
      {
        "command": "model-worklog.trace.open",
        "title": "Open Trace",
        "category": "Model Logger",
        "enablement": "modelWorklog.traceRead"
      },
      {
        "command": "model-worklog.trace.loadMore",
        "title": "Load More Traces",
        "category": "Model Logger",
        "enablement": "modelWorklog.traceRead && !modelWorklog.traceBusy"
      },
      {
        "command": "model-worklog.trace.loadMoreSpans",
        "title": "Load More Spans",
        "category": "Model Logger",
        "enablement": "modelWorklog.traceRead && modelWorklog.traceSelected && !modelWorklog.traceBusy"
      },
      {
        "command": "model-worklog.trace.export",
        "title": "Export Captured Trace JSON",
        "category": "Model Logger",
        "icon": "$(export)",
        "enablement": "modelWorklog.traceRead && !modelWorklog.traceBusy"
      },
      {
        "command": "model-worklog.trace.delete",
        "title": "Delete Trace",
        "category": "Model Logger",
        "icon": "$(trash)",
        "enablement": "modelWorklog.traceAdmin && !modelWorklog.traceBusy"
      }
    ],
    "views": {
      "model-worklog": [
        {
          "id": "model-worklog.traces",
          "name": "Traces"
        },
        {
          "id": "model-worklog.sessions",
          "name": "Logs"
        }
      ],
      "model-worklog-details": [
        {
          "id": "model-worklog.traceDetails",
          "name": "Trace Details",
          "type": "webview"
        },
        {
          "id": "model-worklog.logDetails",
          "name": "Log Details",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "model-worklog.trace.selectProject", "when": "view == model-worklog.traces", "group": "navigation@1" },
        { "command": "model-worklog.trace.refresh", "when": "view == model-worklog.traces || view == model-worklog.traceDetails", "group": "navigation@2" },
        { "command": "model-worklog.trace.configureSdk", "when": "view == model-worklog.traces && modelWorklog.traceAdmin", "group": "navigation@3" },
        { "command": "model-worklog.trace.export", "when": "view == model-worklog.traceDetails && modelWorklog.traceRead && modelWorklog.traceSelected", "group": "navigation@3" },
        { "command": "model-worklog.trace.delete", "when": "view == model-worklog.traceDetails && modelWorklog.traceAdmin && modelWorklog.traceSelected", "group": "navigation@4" }
      ],
      "view/item/context": [
        { "command": "model-worklog.trace.export", "when": "view == model-worklog.traces && (viewItem == trace-admin || viewItem == trace-reader)", "group": "inline@1" },
        { "command": "model-worklog.trace.delete", "when": "view == model-worklog.traces && viewItem == trace-admin", "group": "inline@2" }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "model-worklog-details",
          "title": "Model Logger",
          "icon": "media/model-worklog.svg"
        }
      ],
      "activitybar": [
        {
          "id": "model-worklog",
          "title": "Model Logger",
          "icon": "media/model-worklog.svg"
        }
      ]
    },
    "configuration": {
      "title": "Model Logger",
      "properties": {
        "model-worklog.trace.projectId": {
          "type": "string",
          "default": "default",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$",
          "description": "Project displayed in Traces. Applications must explicitly instrument this project using model-worklog-sdk. This setting contains no credential.",
          "scope": "window"
        },
        "model-worklog.supervisorUrl": {
          "type": "string",
          "default": "http://127.0.0.1:43199",
          "description": "Loopback URL for the local Model Logger supervisor.",
          "scope": "machine"
        },
        "model-worklog.codex.defaultDurationMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 240,
          "description": "Maximum duration for a supervisor-managed Codex session.",
          "scope": "machine"
        },
        "model-worklog.codex.defaultTokenBudget": {
          "type": "number",
          "default": 50000,
          "minimum": 1,
          "maximum": 2000000,
          "description": "Maximum reported token budget for a supervisor-managed Codex session.",
          "scope": "machine"
        },
        "model-worklog.copilot.defaultDurationMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 240,
          "description": "Maximum duration for a supervisor-managed Copilot CLI session.",
          "scope": "machine"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run build:packages && npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run build:packages && npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "npm run package && vsce package --no-dependencies --allow-missing-repository",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run build:packages && npm run compile-tests && npm run compile && npm run lint",
    "build:packages": "npm --prefix ../.. run build",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "model-worklog-schema": "file:../../packages/event-schema"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.137.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.11.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "icon": "media/model-logger.png"
}
